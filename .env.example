# GrocerAgent production example
DATABASE_URL="file:/var/lib/grocer-agent/prod.db"
GROCER_AGENT_API_KEY="ga_change_me"

# Standalone Telegram bot: Nákupca
# Create with BotFather, then set webhook to:
# https://nakup.voskar.sk/api/v1/telegram/nakupca
NAKUPCA_TELEGRAM_BOT_TOKEN=""
NAKUPCA_TELEGRAM_WEBHOOK_SECRET="change-this-long-random-secret"

# Standalone Telegram bot: Domáci Nákupca
# Create with BotFather, then set webhook to:
# https://nakup.voskar.sk/api/v1/telegram/domaci-nakupca
DOMACI_NAKUPCA_TELEGRAM_BOT_TOKEN=""
DOMACI_NAKUPCA_TELEGRAM_WEBHOOK_SECRET="change-this-other-long-random-secret"

# Shared family list source.
# Preferred production bridge: Google Keep -> Google Sheets via Apps Script,
# then configure the Sheet ID here. Google Keep itself has no reliable public server API.
DOMACI_NAKUPCA_GOOGLE_KEEP_NOTE_URL=""
DOMACI_NAKUPCA_GOOGLE_SHEET_ID=""

# Online grocery portals. Store only in hosting secrets, never in git/chat logs.
DOMACI_NAKUPCA_TESCO_USERNAME=""
DOMACI_NAKUPCA_TESCO_PASSWORD=""
DOMACI_NAKUPCA_LUNYS_USERNAME=""
DOMACI_NAKUPCA_LUNYS_PASSWORD=""
